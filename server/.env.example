# =============================================================================
# Server configuration template.
#
# Copy to `.env` and fill in real values. NEVER commit a filled-in file —
# `.gitignore` blocks every `.env*` except this template.
#
# Every variable below is declared in `config/env.ts`, which validates them at
# boot. Required variables missing or malformed will stop the server from
# starting; optional ones only disable the feature that needs them.
# =============================================================================

# --- Core (required) ---------------------------------------------------------

# MongoDB connection string. Must start with mongodb:// or mongodb+srv://.
MONGODB_URI=mongodb://localhost:27017/comfast

# Signing key for user session JWTs. Must be at least 32 characters of
# high-entropy random data — this key alone is what stops anyone from forging a
# session for any user. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Public URL of the frontend. Also acts as the CORS allow-list: only these
# origins may call the API from a browser. Comma-separate for multiple.
FRONTEND_URL=http://localhost:5173

# Public URL of this API, used to build OAuth callback URLs.
BACKEND_URL=http://localhost:3000

# Port the server listens on.
PORT=3000

# --- Zernio — social publishing (required) -----------------------------------
# https://zernio.com — dashboard > API keys
ZERNIO_API_KEY=

# --- Google OAuth — "Sign in with Google" (optional) --------------------------
# https://console.cloud.google.com > APIs & Services > Credentials
# Both must be set together, or the Google login button is disabled.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Google Gemini — AI text generation (optional) ----------------------------
# https://aistudio.google.com/apikey
# Unset disables AI post generation.
GEMINI_API_KEY=

# --- Leonardo.ai — AI image generation (optional) -----------------------------
# https://app.leonardo.ai > API access
# Unset means posts generate text only, no image.
LEONARDO_API_KEY=

# --- Cloudinary — media hosting (optional) ------------------------------------
# https://console.cloudinary.com > Dashboard
# All three must be set together, or media upload is disabled.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Feature flags ------------------------------------------------------------

# Comma-separated list of active social networks.
# Valid: twitter, linkedin, facebook, instagram, tiktok
# Empty or unset enables all of them.
ENABLED_PLATFORMS=

# Set to "production" in deployed environments. Production applies stricter
# checks: no weak JWT secret, no wildcard CORS.
NODE_ENV=development
