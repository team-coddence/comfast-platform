# =============================================================================
# Server configuration template.
#
# Copy to `.env` and fill in real values. NEVER commit a filled-in file —
# `.gitignore` blocks every `.env*` except this template.
#
# Every variable below is declared in `config/env.ts`, which validates them at
# boot. Required variables missing or malformed will stop the server from
# starting; optional ones only disable the feature that needs them.
# =============================================================================

# --- Core (required) ---------------------------------------------------------

# MongoDB connection string. Must start with mongodb:// or mongodb+srv://.
MONGODB_URI=mongodb://localhost:27017/comfast

# Signing key for user session JWTs. Must be at least 32 characters of
# high-entropy random data — this key alone is what stops anyone from forging a
# session for any user. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Public URL of the frontend. Also acts as the CORS allow-list: only these
# origins may call the API from a browser. Comma-separate for multiple.
FRONTEND_URL=http://localhost:5173

# Public URL of this API, used to build OAuth callback URLs.
BACKEND_URL=http://localhost:3000

# Port the server listens on.
PORT=3000

# --- Zernio — social publishing (required) -----------------------------------
# https://zernio.com — dashboard > API keys
ZERNIO_API_KEY=

# --- Google OAuth — "Sign in with Google" (optional) --------------------------
# https://console.cloud.google.com > APIs & Services > Credentials
# Both must be set together, or the Google login button is disabled.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Google Gemini — AI text generation (optional) ----------------------------
# https://aistudio.google.com/apikey
# Unset disables AI post generation.
GEMINI_API_KEY=

# --- Leonardo.ai — AI image generation (optional) -----------------------------
# https://app.leonardo.ai > API access
# Unset means posts generate text only, no image.
LEONARDO_API_KEY=

# --- Cloudinary — media hosting (optional) ------------------------------------
# https://console.cloudinary.com > Dashboard
# All three must be set together, or media upload is disabled.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Subscription & free trial -------------------------------------------------

# How many days a new workspace may use the product before it has to subscribe.
# The trial is anchored on the owner, so creating extra workspaces does not
# mint extra trials.
BILLING_TRIAL_DAYS=3

# Days a paid workspace keeps working after its period ends. Mobile money
# settlement can lag, and cutting a paying customer off mid-payment is the
# worst possible moment.
BILLING_GRACE_DAYS=2

# Pricing currency. XOF has no minor unit — amounts in config/billing.ts are
# whole francs. Changing this needs the amount handling revisited, not just
# this string.
BILLING_CURRENCY=XOF

# --- Online payments -----------------------------------------------------------

# How checkout behaves:
#   auto  — real processor where one is configured, simulated for the rest.
#           The default outside production.
#   live  — real processors only; a missing credential fails the checkout
#           loudly instead of silently simulating it. The default in production.
#   fake  — simulate everything. REFUSED IN PRODUCTION: the server will not
#           boot, because simulated payments grant free subscriptions.
PAYMENTS_MODE=auto

# Optional: pin a processor per payment method instead of letting the server
# pick the first configured one. Values: paygate, cinetpay, fake.
PAYMENTS_MOBILE_PROVIDER=
PAYMENTS_CARD_PROVIDER=

# --- PayGate Global — Mixx By Yas and Flooz (optional) --------------------------
# https://paygateglobal.com — Espace marchand > API
# Unset means mobile money checkout is simulated outside production, and
# unavailable in production.
#
# Set the callback URL in the PayGate dashboard to:
#   <BACKEND_URL>/api/billing/webhooks/paygate
# It is only a hint — the server re-reads every transaction from PayGate before
# crediting anything — so a missed callback costs nothing but a minute's delay.
PAYGATE_API_KEY=

# --- CinetPay — bank card (optional) --------------------------------------------
# https://cinetpay.com — Intégrations > API keys
# All three must be set together. The secret key authenticates CinetPay's
# server-to-server notification (the `x-token` HMAC).
#
# Notification URL to configure at CinetPay:
#   <BACKEND_URL>/api/billing/webhooks/cinetpay
CINETPAY_SITE_ID=
CINETPAY_API_KEY=
CINETPAY_SECRET_KEY=

# --- Feature flags ------------------------------------------------------------

# Comma-separated list of active social networks.
# Valid: twitter, linkedin, facebook, instagram, tiktok
# Empty or unset enables all of them.
ENABLED_PLATFORMS=

# Set to "production" in deployed environments. Production applies stricter
# checks: no weak JWT secret, no wildcard CORS.
NODE_ENV=development
