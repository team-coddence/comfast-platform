# Credentials for the local MongoDB container in docker-compose.yml.
# Copy to `.env` (git-ignored) and set real values before `docker compose up`.
#
# These must match the credentials in the MONGODB_URI you put in server/.env.
# Generate a password with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"

MONGO_ROOT_USERNAME=unipostadmin
MONGO_ROOT_PASSWORD=
