# Credentials for the MongoDB container in docker-compose.yml, and for the
# connection string compose builds for the API container.
#
# Copy to `.env` (git-ignored) and set real values before `docker compose up`.
# Application secrets do NOT go here — those live in server/.env.

# Use a URL-safe password: it is interpolated into a mongodb:// URI, where
# characters such as @ : / ? # break parsing. This generator is URL-safe:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
#
# NOTE: these two values only take effect when the database volume is created
# for the first time. Changing them later does not re-key an existing volume —
# rotate with db.changeUserPassword() in mongosh, or destroy the volume.
MONGO_ROOT_USERNAME=unipostadmin
MONGO_ROOT_PASSWORD=

# Database name the API uses inside the compose network.
#
# Existing deployments should set this to "test". A MONGODB_URI written as
# mongodb://host:port/ with no path selects Mongo's default database, which is
# named "test" — so that is where data created before this file landed. Set it
# to "comfast" only for a fresh volume, or after migrating the collections.
MONGO_DATABASE=test
